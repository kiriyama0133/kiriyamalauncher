using kiriyamalauncher.Data.Entities;
using System;

namespace kiriyamalauncher.Business.Modules.UserProfile.DTOs;

/// <summary>
/// 界面与联机偏好（整机一份，不挂在账号上）。
/// </summary>
public class UserPreferencesDto
{
    /// <summary>数据库主键。</summary>
    public uint? Id { get; set; }

    /// <summary>界面字体大小。</summary>
    public double FontSize { get; set; } = 14d;

    /// <summary>ZeroTier Moon 服务器节点 ID。</summary>
    public string MoonServerIp { get; set; } = string.Empty;

    /// <summary>ZeroTier 网络 ID（16 位十六进制）。</summary>
    public string ZeroTierNetworkId { get; set; } = string.Empty;

    /// <summary>自建控制器生成的网络 ID（16 位十六进制，仅「自建控制器」模式使用）。</summary>
    public string SelfHostedNetworkId { get; set; } = string.Empty;

    /// <summary>ZeroTier 连接模式：Official（my.zerotier.com）/ SelfHosted（自建控制器）/ Relay（中继服务器）。</summary>
    public string ZeroTierConnectionMode { get; set; } = ZeroTierSettings.OfficialController;

    /// <summary>中继服务器（服务端联机）的 IP 或主机名。</summary>
    public string RelayServerIp { get; set; } = string.Empty;

    /// <summary>中继服务器（服务端联机）的端口。</summary>
    public int RelayServerPort { get; set; } = ZeroTierSettings.DefaultRelayServerPort;

    /// <summary>ZeroTier 传输引擎：Sockets（libzt 内嵌节点）/ Client（嵌入的 ZeroTier 客户端）。</summary>
    public string ZeroTierTransportBackend { get; set; } = ZeroTierSettings.ClientBackend;

    /// <summary>明暗模式：Default（跟随系统）/ Light / Dark。</summary>
    public string BaseTheme { get; set; } = "Default";

    /// <summary>配色主题（SukiUI 内置配色名：Blue / Green / Red / Orange）。</summary>
    public string ColorTheme { get; set; } = "Blue";

    /// <summary>偏好更新时间。</summary>
    public DateTime? UpdatedAt { get; set; }
}
