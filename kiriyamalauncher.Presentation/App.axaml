<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="kiriyamalauncher.Presentation.App"
             xmlns:b="using:kiriyamalauncher.Presentation.Base"
             xmlns:i="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sukiUi="clr-namespace:SukiUI;assembly=SukiUI"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<b:ViewLocator />
	</Application.DataTemplates>

	<Application.Styles>
		<sukiUi:SukiTheme ThemeColor="Blue" Locale="zh-CN" />
		<i:MaterialIconStyles />
		<StyleInclude Source="/Base/Styles/Colors.axaml" />
		<StyleInclude Source="/Base/Styles/UserControlStyles.axaml" />
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
		<StyleInclude Source="avares://AvaloniaProgressRing/Styles/ProgressRing.xaml" />
	</Application.Styles>

	<Application.Resources>
		<FontFamily x:Key="ViewHeadingFont">avares://kiriyamalauncher.Presentation/Base/Assets/Fonts/akashi-font#Akashi</FontFamily>

		<!--
			界面字号：运行时由全局快照按用户偏好覆盖（AppSnapshot.ApplyFontSize），
			这里的值只是默认值 / 设计器预览用。
		-->
		<x:Double x:Key="AppFontSizeSmall">12</x:Double>
		<x:Double x:Key="AppFontSizeCompact">13</x:Double>
		<x:Double x:Key="AppFontSizeNormal">14</x:Double>
		<x:Double x:Key="AppFontSizeLarge">15</x:Double>
		<x:Double x:Key="AppFontSizeSubtitle">18</x:Double>
		<x:Double x:Key="AppFontSizeTitle">26</x:Double>
	</Application.Resources>
	
</Application>
