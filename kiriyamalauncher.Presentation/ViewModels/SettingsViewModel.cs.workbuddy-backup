using CommunityToolkit.Mvvm.ComponentModel;
using CommunityToolkit.Mvvm.Input;
using kiriyamalauncher.Data.Entities;
using kiriyamalauncher.Presentation.Base.Services.Preferences;
using Material.Icons;
using System;

namespace kiriyamalauncher.Presentation.ViewModels;

/// <summary>
/// 设置页：字体大小、ZeroTier Moon 服务器、网络 ID 与连接模式。
/// 改动会立即生效，并通过全局快照读写器（防抖）写回 SQLite。
/// </summary>
public partial class SettingsViewModel : PageViewModel
{
    private readonly IAppSnapshot _snapshot;

    /// <summary>正在从快照同步连接模式时，避免两个单选按钮来回触发。</summary>
    private bool _isSyncingConnectionMode;

    /// <summary>正在从快照同步传输引擎时，避免两个单选按钮来回触发。</summary>
    private bool _isSyncingTransportBackend;

    public override string DisplayName => "设置";

    public override MaterialIconKind Icon => MaterialIconKind.CogOutline;

    /// <summary>可设置的最小字号。</summary>
    public double MinimumFontSize => 12d;

    /// <summary>可设置的最大字号。</summary>
    public double MaximumFontSize => 22d;

    [ObservableProperty]
    private double _fontSize = 14d;

    /// <summary>正在编辑的 ZeroTier Moon 服务器地址。</summary>
    [ObservableProperty]
    private string _moonServerIp = string.Empty;

    /// <summary>Moon 输入框聚焦时才显示「确认 / 取消」。</summary>
    [ObservableProperty]
    private bool _isEditingMoonServer;

    /// <summary>正在编辑的 ZeroTier 网络 ID。</summary>
    [ObservableProperty]
    private string _zeroTierNetworkId = string.Empty;

    /// <summary>网络 ID 输入框聚焦时才显示「确认 / 取消」。</summary>
    [ObservableProperty]
    private bool _isEditingNetworkId;

    /// <summary>网络 ID 的校验错误提示（为空表示没有错误）。</summary>
    [ObservableProperty]
    private string _networkIdError = string.Empty;

    /// <summary>是否有网络 ID 校验错误。</summary>
    public bool HasNetworkIdError => !string.IsNullOrEmpty(NetworkIdError);

    /// <summary>正在编辑的自建控制器网络 ID。</summary>
    [ObservableProperty]
    private string _selfHostedNetworkId = string.Empty;

    /// <summary>自建控制器网络 ID 输入框聚焦时才显示「确认 / 取消」。</summary>
    [ObservableProperty]
    private bool _isEditingSelfHostedNetworkId;

    /// <summary>自建控制器网络 ID 的校验错误提示（为空表示没有错误）。</summary>
    [ObservableProperty]
    private string _selfHostedNetworkIdError = string.Empty;

    /// <summary>是否有自建控制器网络 ID 校验错误。</summary>
    public bool HasSelfHostedNetworkIdError => !string.IsNullOrEmpty(SelfHostedNetworkIdError);

    /// <summary>连接模式：是否使用 my.zerotier.com 官方控制器。</summary>
    [ObservableProperty]
    private bool _isOfficialController = true;

    /// <summary>连接模式：是否使用自建控制器。</summary>
    [ObservableProperty]
    private bool _isSelfHostedController;

    /// <summary>连接模式：是否使用中继服务器（服务端联机）。</summary>
    [ObservableProperty]
    private bool _isRelayServer;

    /// <summary>中继服务器（服务端联机）的 IP 或主机名。</summary>
    [ObservableProperty]
    private string _relayServerIp = string.Empty;

    /// <summary>中继服务器（服务端联机）的端口。</summary>
    [ObservableProperty]
    private string _relayServerPort = string.Empty;

    /// <summary>中继服务器输入框聚焦时才显示「确认 / 取消」。</summary>
    [ObservableProperty]
    private bool _isEditingRelayServer;

    /// <summary>中继服务器端口/地址的校验错误提示（为空表示没有错误）。</summary>
    [ObservableProperty]
    private string _relayServerError = string.Empty;

    /// <summary>是否有中继服务器校验错误。</summary>
    public bool HasRelayServerError => !string.IsNullOrEmpty(RelayServerError);

    /// <summary>传输引擎：是否使用 ZeroTier.Sockets（libzt 内嵌节点）。</summary>
    [ObservableProperty]
    private bool _isSocketsBackend;

    /// <summary>传输引擎：是否使用嵌入的 ZeroTier 客户端（走系统虚拟网卡）。</summary>
    [ObservableProperty]
    private bool _isClientBackend = true;

    /// <summary>当前传输引擎的说明文字。</summary>
    public string TransportBackendHint => IsClientBackend
        ? "嵌入的 ZeroTier 客户端：自动安装官方客户端并挂载真虚拟网卡，游戏直接通过系统网卡互通，无需注入组件。"
        : "ZeroTier.Sockets：内嵌节点，无需安装客户端、无需虚拟网卡，游戏联机由本程序直接代理。";

    /// <summary>当前连接模式的说明文字。</summary>
    public string ConnectionModeHint => IsRelayServer
        ? "中继服务器（服务端联机）：房间大厅由中继服务器提供，加入房间后通过服务器互通。下面填服务器地址。"
        : IsSelfHostedController
            ? "自建控制器：网络由你自己的 zerotier-one controller 提供（moon 只负责根节点与中继），网络 ID 填自建控制器生成的 16 位 ID。"
            : "my.zerotier.com：在官网创建网络后，把 16 位网络 ID 填在下面；走官方根节点，不需要 moon。若是私有网络，记得在官网把新成员（节点 ID）勾选 Auth。";

    /// <summary>上一次保存的 Moon 服务器地址（用于「取消」还原）。</summary>
    private string _savedMoonServerIp = string.Empty;

    /// <summary>上一次保存的网络 ID（用于「取消」还原）。</summary>
    private string _savedNetworkId = string.Empty;

    /// <summary>上一次保存的自建控制器网络 ID（用于「取消」还原）。</summary>
    private string _savedSelfHostedNetworkId = string.Empty;

    /// <summary>上一次保存的中继服务器 IP（用于「取消」还原）。</summary>
    private string _savedRelayServerIp = string.Empty;

    /// <summary>上一次保存的中继服务器端口（用于「取消」还原）。</summary>
    private string _savedRelayServerPort = string.Empty;

    public SettingsViewModel(IAppSnapshot snapshot)
    {
        _snapshot = snapshot;
        _fontSize = snapshot.Preferences.FontSize;
        _moonServerIp = snapshot.Preferences.MoonServerIp;
        _savedMoonServerIp = _moonServerIp;
        _zeroTierNetworkId = snapshot.Preferences.ZeroTierNetworkId;
        _savedNetworkId = _zeroTierNetworkId;
        _selfHostedNetworkId = snapshot.Preferences.SelfHostedNetworkId;
        _savedSelfHostedNetworkId = _selfHostedNetworkId;
        _relayServerIp = snapshot.Preferences.RelayServerIp;
        _savedRelayServerIp = _relayServerIp;
        _relayServerPort = snapshot.Preferences.RelayServerPort.ToString();
        _savedRelayServerPort = _relayServerPort;
        SyncConnectionMode();
        SyncTransportBackend();

        snapshot.Changed += OnSnapshotChanged;
    }

    private void OnSnapshotChanged(object? sender, EventArgs e)
    {
        FontSize = _snapshot.Preferences.FontSize;
        SyncConnectionMode();
        SyncTransportBackend();

        // 正在编辑时不要覆盖用户输入。
        if (!IsEditingMoonServer)
        {
            MoonServerIp = _snapshot.Preferences.MoonServerIp;
            _savedMoonServerIp = MoonServerIp;
        }

        if (!IsEditingNetworkId)
        {
            ZeroTierNetworkId = _snapshot.Preferences.ZeroTierNetworkId;
            _savedNetworkId = ZeroTierNetworkId;
        }

        if (!IsEditingSelfHostedNetworkId)
        {
            SelfHostedNetworkId = _snapshot.Preferences.SelfHostedNetworkId;
            _savedSelfHostedNetworkId = SelfHostedNetworkId;
        }

        if (!IsEditingRelayServer)
        {
            RelayServerIp = _snapshot.Preferences.RelayServerIp;
            _savedRelayServerIp = RelayServerIp;
            RelayServerPort = _snapshot.Preferences.RelayServerPort.ToString();
            _savedRelayServerPort = RelayServerPort;
        }
    }

    partial void OnFontSizeChanged(double value) => _snapshot.UpdateFontSize(value);

    partial void OnNetworkIdErrorChanged(string value) => OnPropertyChanged(nameof(HasNetworkIdError));

    partial void OnSelfHostedNetworkIdErrorChanged(string value) => OnPropertyChanged(nameof(HasSelfHostedNetworkIdError));

    partial void OnRelayServerErrorChanged(string value) => OnPropertyChanged(nameof(HasRelayServerError));

    partial void OnIsOfficialControllerChanged(bool value)
    {
        if (_isSyncingConnectionMode || !value)
        {
            return;
        }

        ApplyConnectionMode(ZeroTierSettings.OfficialController);
    }

    partial void OnIsSelfHostedControllerChanged(bool value)
    {
        if (_isSyncingConnectionMode || !value)
        {
            return;
        }

        ApplyConnectionMode(ZeroTierSettings.SelfHostedController);
    }

    partial void OnIsRelayServerChanged(bool value)
    {
        if (_isSyncingConnectionMode || !value)
        {
            return;
        }

        ApplyConnectionMode(ZeroTierSettings.RelayServer);
    }

    partial void OnIsSocketsBackendChanged(bool value)
    {
        if (_isSyncingTransportBackend || !value)
        {
            return;
        }

        ApplyTransportBackend(ZeroTierSettings.SocketsBackend);
    }

    partial void OnIsClientBackendChanged(bool value)
    {
        if (_isSyncingTransportBackend || !value)
        {
            return;
        }

        ApplyTransportBackend(ZeroTierSettings.ClientBackend);
    }

    /// <summary>确认：写入 Moon 服务器地址（防抖落库）。</summary>
    [RelayCommand]
    private void SaveMoonServer()
    {
        _snapshot.UpdateMoonServerIp(MoonServerIp);

        _savedMoonServerIp = _snapshot.Preferences.MoonServerIp;
        MoonServerIp = _savedMoonServerIp;
        IsEditingMoonServer = false;
    }

    /// <summary>取消：还原成上一次保存的 Moon 服务器地址。</summary>
    [RelayCommand]
    private void CancelMoonServer()
    {
        MoonServerIp = _savedMoonServerIp;
        IsEditingMoonServer = false;
    }

    /// <summary>确认：校验后写入网络 ID（防抖落库）。</summary>
    [RelayCommand]
    private void SaveNetworkId()
    {
        string value = (ZeroTierNetworkId ?? string.Empty).Trim().ToLowerInvariant();

        if (!ZeroTierSettings.IsValidNetworkId(value))
        {
            NetworkIdError = "网络 ID 需要是 16 位十六进制，例如 633e31d8a2724274。";
            return;
        }

        NetworkIdError = string.Empty;
        _snapshot.UpdateZeroTierNetworkId(value);

        _savedNetworkId = _snapshot.Preferences.ZeroTierNetworkId;
        ZeroTierNetworkId = _savedNetworkId;
        IsEditingNetworkId = false;
    }

    /// <summary>取消：还原成上一次保存的网络 ID。</summary>
    [RelayCommand]
    private void CancelNetworkId()
    {
        ZeroTierNetworkId = _savedNetworkId;
        NetworkIdError = string.Empty;
        IsEditingNetworkId = false;
    }

    /// <summary>确认：校验后写入自建控制器网络 ID（防抖落库）。</summary>
    [RelayCommand]
    private void SaveSelfHostedNetworkId()
    {
        string value = (SelfHostedNetworkId ?? string.Empty).Trim().ToLowerInvariant();

        if (value.Length > 0 && !ZeroTierSettings.IsValidNetworkId(value))
        {
            SelfHostedNetworkIdError = "网络 ID 需要是 16 位十六进制。";
            return;
        }

        SelfHostedNetworkIdError = string.Empty;
        _snapshot.UpdateSelfHostedNetworkId(value);

        _savedSelfHostedNetworkId = _snapshot.Preferences.SelfHostedNetworkId;
        SelfHostedNetworkId = _savedSelfHostedNetworkId;
        IsEditingSelfHostedNetworkId = false;
    }

    /// <summary>取消：还原成上一次保存的自建控制器网络 ID。</summary>
    [RelayCommand]
    private void CancelSelfHostedNetworkId()
    {
        SelfHostedNetworkId = _savedSelfHostedNetworkId;
        SelfHostedNetworkIdError = string.Empty;
        IsEditingSelfHostedNetworkId = false;
    }

    /// <summary>确认：写入中继服务器 IP 与端口（防抖落库）。</summary>
    [RelayCommand]
    private void SaveRelayServer()
    {
        string ip = (RelayServerIp ?? string.Empty).Trim();
        string portText = (RelayServerPort ?? string.Empty).Trim();

        if (!int.TryParse(portText, out int port) || port is < 1 or > 65535)
        {
            RelayServerError = "端口需要是 1~65535 之间的数字。";
            return;
        }

        RelayServerError = string.Empty;
        _snapshot.UpdateRelayServerIp(ip);
        _snapshot.UpdateRelayServerPort(port);

        _savedRelayServerIp = _snapshot.Preferences.RelayServerIp;
        RelayServerIp = _savedRelayServerIp;
        _savedRelayServerPort = _snapshot.Preferences.RelayServerPort.ToString();
        RelayServerPort = _savedRelayServerPort;
        IsEditingRelayServer = false;
    }

    /// <summary>取消：还原成上一次保存的中继服务器地址。</summary>
    [RelayCommand]
    private void CancelRelayServer()
    {
        RelayServerIp = _savedRelayServerIp;
        RelayServerPort = _savedRelayServerPort;
        RelayServerError = string.Empty;
        IsEditingRelayServer = false;
    }

    /// <summary>切换连接模式：写进偏好（防抖落库）。</summary>
    private void ApplyConnectionMode(string connectionMode)
    {
        _snapshot.UpdateZeroTierConnectionMode(connectionMode);
        SyncConnectionMode();
    }

    /// <summary>切换传输引擎：写进偏好（防抖落库）。</summary>
    private void ApplyTransportBackend(string transportBackend)
    {
        _snapshot.UpdateZeroTierTransportBackend(transportBackend);
        SyncTransportBackend();
    }

    /// <summary>把快照里的连接模式同步到三个单选按钮上（不触发回写）。</summary>
    private void SyncConnectionMode()
    {
        string mode = _snapshot.Preferences.ZeroTierConnectionMode;
        bool isSelfHosted = string.Equals(mode, ZeroTierSettings.SelfHostedController, StringComparison.OrdinalIgnoreCase);
        bool isRelay = string.Equals(mode, ZeroTierSettings.RelayServer, StringComparison.OrdinalIgnoreCase);

        _isSyncingConnectionMode = true;
        IsSelfHostedController = isSelfHosted;
        IsRelayServer = isRelay;
        IsOfficialController = !isSelfHosted && !isRelay;
        _isSyncingConnectionMode = false;

        OnPropertyChanged(nameof(ConnectionModeHint));
    }

    /// <summary>把快照里的传输引擎同步到两个单选按钮上（不触发回写）。</summary>
    private void SyncTransportBackend()
    {
        bool isClient = string.Equals(
            _snapshot.Preferences.ZeroTierTransportBackend,
            ZeroTierSettings.ClientBackend,
            StringComparison.OrdinalIgnoreCase);

        _isSyncingTransportBackend = true;
        IsClientBackend = isClient;
        IsSocketsBackend = !isClient;
        _isSyncingTransportBackend = false;

        OnPropertyChanged(nameof(TransportBackendHint));
    }
}
