<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="kiriyamalauncher.Presentation.Views.GameSessionView"
             x:DataType="vm:GameSessionViewModel"
			 xmlns:c="clr-namespace:kiriyamalauncher.Presentation.Base.Controls"
			 xmlns:vm="clr-namespace:kiriyamalauncher.Presentation.ViewModels"
			 xmlns:views="clr-namespace:kiriyamalauncher.Presentation.Views"
			 xmlns:i="using:Material.Icons.Avalonia"
			 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI">

	<UserControl.Styles>
		<!-- 游戏卡片按钮：手型指针，悬停不放大，改为高亮卡片边线。 -->
		<Style Selector="Button.card">
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Button.card:pointerover">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="RenderTransform" Value="none" />
		</Style>

		<Style Selector="Button.card:pressed, Button.card:pressed:pointerover">
			<Setter Property="RenderTransform" Value="none" />
		</Style>

		<Style Selector="Button.card c|GameCard Border#PART_Card">
			<Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
		</Style>

		<Style Selector="Button.card:pointerover c|GameCard Border#PART_Card">
			<Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
		</Style>

		<!-- 联机面板里的说明卡片：占满可用宽度。 -->
		<Style Selector="suki|GlassCard.boardCard">
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Padding" Value="18" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
	</UserControl.Styles>

	<!--
		游戏房间：用 SukiTransitioningContentControl 做「游戏列表 ↔ 游戏板块」两层切换，
		切换时享受 SukiUI 的 cross-fade 过渡动画（不带面包屑，避免进入游戏后再切页导致导航栈异常）。
	-->
	<suki:SukiTransitioningContentControl Content="{Binding ActivePageContent}">

		<suki:SukiTransitioningContentControl.DataTemplates>

			<!-- 一、游戏类别列表页 -->
			<DataTemplate DataType="{x:Type vm:GameListPageViewModel}">
				<DockPanel Margin="24">
					<StackPanel DockPanel.Dock="Top" Spacing="6">
						<TextBlock Text="游戏联机" FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="DemiBold" />
						<TextBlock Text="{Binding Session.ListStatusText}" Opacity="0.7" TextWrapping="Wrap" MaxWidth="620"
								   HorizontalAlignment="Left" />
					</StackPanel>

					<ScrollViewer Margin="0,20,0,0">
						<ItemsControl ItemsSource="{Binding Session.Games}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type vm:GameViewModel}">
									<Button Classes="Basic NoPressedAnimation card"
											Padding="0"
											Margin="0,0,16,16"
											CornerRadius="14"
											HorizontalAlignment="Left"
											Foreground="{DynamicResource SukiText}"
											Command="{Binding OpenCommand}"
											ToolTip.Tip="{Binding Description}">
										<c:GameCard />
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</DockPanel>
			</DataTemplate>

			<!-- 二、某个游戏的联机面板页 -->
			<DataTemplate DataType="{x:Type vm:GameBoardPageViewModel}">
				<DockPanel Margin="24">
					<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">

						<StackPanel Grid.Column="0" Spacing="6">
							<TextBlock Text="{Binding Game.Name}" FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="DemiBold" />
							<TextBlock Text="{Binding Session.StatusText}" Opacity="0.7" TextWrapping="Wrap" MaxWidth="560"
									   HorizontalAlignment="Left" />
						</StackPanel>

					<!-- 没接入时是「连接到虚拟局域网」，接入之后变成「断开局域网」。
						 连接 / 断开进行中时，按钮旁显示 Glow 加载指示器。 -->
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">

						<!-- 连接 / 断开进行中的加载指示器（IsBusy 期间显示）。 -->
						<suki:Loading LoadingStyle="Glow"
									  Width="16" Height="16"
									  VerticalAlignment="Center"
									  IsVisible="{Binding Session.IsBusy}" />

						<Button Classes="Flat"
								Cursor="Hand"
								IsVisible="{Binding !Session.IsConnected}"
								Command="{Binding Session.ConnectToVirtualNetworkCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<i:MaterialIcon Kind="LanConnect" Width="16" Height="16" Foreground="White" />
								<TextBlock Text="连接到虚拟局域网" />
							</StackPanel>
						</Button>

						<Button Classes="Basic"
								Cursor="Hand"
								IsVisible="{Binding Session.IsConnected}"
								Command="{Binding Session.DisconnectFromVirtualNetworkCommand}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<i:MaterialIcon Kind="LanDisconnect" Width="16" Height="16" />
								<TextBlock Text="断开局域网" />
							</StackPanel>
						</Button>
					</StackPanel>
					</Grid>

					<ScrollViewer Margin="0,20,0,0">
						<StackPanel Spacing="12">

							<!-- 中继服务器模式：显示房间大厅（列出 / 搜索 / 创建 / 加入房间）。 -->
							<StackPanel IsVisible="{Binding Session.IsRelayServer}">
								<views:RoomsView DataContext="{Binding Session.Rooms}" />
							</StackPanel>

							<!-- 非中继模式：ZeroTier 虚拟局域网 + 注入组件 + 局域网设备。 -->
							<StackPanel Spacing="12" IsVisible="{Binding !Session.IsRelayServer}">
								<suki:GlassCard Classes="boardCard">
									<suki:GroupBox Header="虚拟局域网">
										<StackPanel Spacing="10">
											<TextBlock TextWrapping="Wrap" Opacity="0.7"
													   Text="连接后会为本机分配一个虚拟 IP。把这个 IP 告诉朋友，大家就能在游戏里用局域网模式互相看到。" />

											<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Session.IsConnected}">
												<i:MaterialIcon Kind="LanConnect" Width="14" Height="14" VerticalAlignment="Center"
																Foreground="{DynamicResource SukiPrimaryColor}" />
												<TextBlock Text="{Binding Session.VirtualIp, StringFormat='当前虚拟 IP：{0}'}"
														   FontSize="{DynamicResource AppFontSizeCompact}"
														   VerticalAlignment="Center"
														   Foreground="{DynamicResource SukiPrimaryColor}" />
											</StackPanel>
										</StackPanel>
									</suki:GroupBox>
								</suki:GlassCard>

								<!-- 游戏联机组件：选择启动路径 / 启动游戏 / 检测进程并注入。
									 仅在使用 ZeroTier.Sockets（libzt 内嵌）引擎时显示；
									 客户端引擎走真虚拟网卡，游戏直接互通，无需注入。 -->
								<ContentControl IsVisible="{Binding Session.ShowInjection}">
									<c:GameIntegrationControl DataContext="{Binding Session.Integration}" />
								</ContentControl>

								<!-- 局域网设备：轮询虚拟局域网并列出发现的设备 -->
								<c:LanDevicesControl DataContext="{Binding Session.LanDevices}" />
							</StackPanel>

						</StackPanel>
					</ScrollViewer>
				</DockPanel>
			</DataTemplate>

		</suki:SukiTransitioningContentControl.DataTemplates>

	</suki:SukiTransitioningContentControl>
</UserControl>
