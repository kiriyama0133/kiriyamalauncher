<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="kiriyamalauncher.Presentation.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
			 xmlns:c="clr-namespace:kiriyamalauncher.Presentation.Base.Controls"
			 xmlns:vm="clr-namespace:kiriyamalauncher.Presentation.ViewModels"
			 xmlns:i="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
			 xmlns:animations="clr-namespace:SukiUI.Animations;assembly=SukiUI">

	<UserControl.Styles>
		<!-- 每个分区一张卡片，纵向排列，占满可用宽度；Expander 负责展开/收起。 -->
		<Style Selector="suki|GlassCard.settingCard">
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Padding" Value="18,10" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>

		<!-- 卡片说明文字（次要信息）。 -->
		<Style Selector="TextBlock.cardHint">
			<Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<!-- 分区内部的小节标题。 -->
		<Style Selector="TextBlock.sectionTitle">
			<Setter Property="FontWeight" Value="DemiBold" />
			<Setter Property="FontSize" Value="{DynamicResource AppFontSizeNormal}" />
		</Style>
	</UserControl.Styles>

	<Border Padding="24">
		<ScrollViewer>
			<StackPanel Spacing="14">

				<!-- 页头：设置。 -->
				<suki:GlassCard Classes="HeaderCard">
					<suki:GroupBox Header="设置">
						<TextBlock Classes="cardHint" Text="字体大小与 ZeroTier 联机参数，改动会立即生效并自动保存。点击分区标题展开或收起。" />
					</suki:GroupBox>
				</suki:GlassCard>

				<!-- 分区一：偏好设置（字体 / 字体大小）。 -->
				<suki:GlassCard Classes="settingCard">
					<Expander ExpandDirection="Down" IsExpanded="True">
						<Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<i:MaterialIcon Kind="Cog" Foreground="{DynamicResource SukiPrimaryColor}" />
								<TextBlock Text="偏好设置" FontWeight="DemiBold" VerticalAlignment="Center" />
							</StackPanel>
						</Expander.Header>

						<StackPanel Spacing="16" Margin="0,10,0,6">
							<!-- 界面字体：先预留，还没实现。 -->
							<StackPanel Spacing="6">
								<TextBlock Classes="sectionTitle" Text="界面字体" />
								<ComboBox IsEnabled="False" MinWidth="280"
										  PlaceholderText="默认字体（后续版本支持自定义）">
									<ComboBoxItem Content="默认字体（预留）" />
								</ComboBox>
								<TextBlock Classes="cardHint" Text="自定义字体尚未实现，这里先占位。" />
							</StackPanel>

							<Separator />

							<!-- 字体大小。 -->
							<StackPanel Spacing="6">
								<TextBlock Classes="sectionTitle" Text="字体大小" />
								<c:FontSizeControl Value="{Binding FontSize, Mode=TwoWay}"
												   Minimum="{Binding MinimumFontSize}"
												   Maximum="{Binding MaximumFontSize}" />
							</StackPanel>
						</StackPanel>
					</Expander>
				</suki:GlassCard>

				<!-- 分区二：连接与传输（连接模式 / 传输引擎）。 -->
				<suki:GlassCard Classes="settingCard">
					<Expander ExpandDirection="Down">
						<Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<i:MaterialIcon Kind="LanConnect" Foreground="{DynamicResource SukiPrimaryColor}" />
								<TextBlock Text="连接与传输" FontWeight="DemiBold" VerticalAlignment="Center" />
							</StackPanel>
						</Expander.Header>

						<StackPanel Spacing="16" Margin="0,10,0,6">
							<!-- 连接模式：切换 ZeroTier 的网络控制方式。 -->
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionTitle" Text="连接模式" />
								<StackPanel Orientation="Horizontal" Spacing="10">
									<RadioButton Classes="Chips" Height="40" GroupName="ZeroTierConnectionMode"
												 Content="my.zerotier.com"
												 IsChecked="{Binding IsOfficialController}" />
									<RadioButton Classes="Chips" Height="40" GroupName="ZeroTierConnectionMode"
												 Content="自建控制器"
												 IsChecked="{Binding IsSelfHostedController}" />
									<RadioButton Classes="Chips" Height="40" GroupName="ZeroTierConnectionMode"
												 Content="中继服务器（服务端联机）"
												 IsChecked="{Binding IsRelayServer}" />
								</StackPanel>
								<TextBlock Classes="cardHint" Text="{Binding ConnectionModeHint}" />
							</StackPanel>

							<Separator />

							<!-- 传输引擎：切换 ZeroTier 的传输后端。 -->
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionTitle" Text="传输引擎" />
								<StackPanel Orientation="Horizontal" Spacing="10">
									<RadioButton Classes="Chips" Height="40" GroupName="ZeroTierTransportBackend"
												 Content="ZeroTier.Sockets"
												 IsChecked="{Binding IsSocketsBackend}" />
									<RadioButton Classes="Chips" Height="40" GroupName="ZeroTierTransportBackend"
												 Content="嵌入的 ZeroTier 客户端"
												 IsChecked="{Binding IsClientBackend}" />
								</StackPanel>
								<TextBlock Classes="cardHint" Text="{Binding TransportBackendHint}" />
							</StackPanel>
						</StackPanel>
					</Expander>
				</suki:GlassCard>

				<!-- 分区三：网络和服务器（ZeroTier 网络 ID / Moon 服务器）。 -->
				<suki:GlassCard Classes="settingCard">
					<Expander ExpandDirection="Down">
						<Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<i:MaterialIcon Kind="Dns" Foreground="{DynamicResource SukiPrimaryColor}" />
								<TextBlock Text="网络和服务器" FontWeight="DemiBold" VerticalAlignment="Center" />
							</StackPanel>
						</Expander.Header>

						<StackPanel Spacing="16" Margin="0,10,0,6">
							<!-- ZeroTier 网络 ID：输入框聚焦时显示「确认 / 取消」。 -->
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionTitle" Text="ZeroTier 网络 ID" />
								<StackPanel Name="NetworkIdRow" Spacing="10"
											GotFocus="OnNetworkIdFocusChanged"
											LostFocus="OnNetworkIdFocusChanged">
									<TextBox Text="{Binding ZeroTierNetworkId}" MaxLength="16"
											 Watermark="16 位十六进制，例如 633e31d8a2724274" />

									<TextBlock Text="{Binding NetworkIdError}" FontSize="{DynamicResource AppFontSizeSmall}"
											   Foreground="{DynamicResource ErrorBrush}"
											   IsVisible="{Binding HasNetworkIdError}" />

									<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
												animations:VisibilityBehavior.IsVisible="{Binding IsEditingNetworkId}"
												animations:VisibilityBehavior.HiddenScale="0.8">
										<Button Classes="Flat" Content="确认" Command="{Binding SaveNetworkIdCommand}" />
										<Button Classes="Basic" Content="取消" Command="{Binding CancelNetworkIdCommand}" />
									</StackPanel>
								</StackPanel>
							</StackPanel>

							<Separator />

							<!-- 自建控制器网络 ID：仅「自建控制器」模式使用。 -->
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionTitle" Text="自建控制器网络 ID" />
								<StackPanel Name="SelfHostedNetworkIdRow" Spacing="10"
											GotFocus="OnSelfHostedNetworkIdFocusChanged"
											LostFocus="OnSelfHostedNetworkIdFocusChanged">
									<TextBox Text="{Binding SelfHostedNetworkId}" MaxLength="16"
											 Watermark="自建控制器生成的 16 位十六进制 ID" />

									<TextBlock Text="{Binding SelfHostedNetworkIdError}" FontSize="{DynamicResource AppFontSizeSmall}"
											   Foreground="{DynamicResource ErrorBrush}"
											   IsVisible="{Binding HasSelfHostedNetworkIdError}" />

									<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
												animations:VisibilityBehavior.IsVisible="{Binding IsEditingSelfHostedNetworkId}"
												animations:VisibilityBehavior.HiddenScale="0.8">
										<Button Classes="Flat" Content="确认" Command="{Binding SaveSelfHostedNetworkIdCommand}" />
										<Button Classes="Basic" Content="取消" Command="{Binding CancelSelfHostedNetworkIdCommand}" />
									</StackPanel>
								</StackPanel>

								<TextBlock Classes="cardHint"
										   Text="自建控制器模式下使用：由你自己的 zerotier-one controller 生成的网络 ID，与官方网络 ID 相互独立。" />
							</StackPanel>

							<Separator />

							<!-- ZeroTier Moon 服务器：输入框聚焦时显示「确认 / 取消」。 -->
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionTitle" Text="ZeroTier Moon 服务器" />
								<StackPanel Name="MoonServerRow" Spacing="10"
											GotFocus="OnMoonServerFocusChanged"
											LostFocus="OnMoonServerFocusChanged">
									<TextBox Text="{Binding MoonServerIp}" MaxLength="16"
											 Watermark="moon 节点 ID，例如 1947244ee4" />

									<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
												animations:VisibilityBehavior.IsVisible="{Binding IsEditingMoonServer}"
												animations:VisibilityBehavior.HiddenScale="0.8">
										<Button Classes="Flat" Content="确认" Command="{Binding SaveMoonServerCommand}" />
										<Button Classes="Basic" Content="取消" Command="{Binding CancelMoonServerCommand}" />
									</StackPanel>
								</StackPanel>

								<TextBlock Classes="cardHint"
										   Text="moon 是自己部署的根节点，只在「自建控制器」模式下生效；填 zerotier-cli 输出的 10 位十六进制节点 ID。" />
							</StackPanel>

							<Separator />

							<!-- 中继服务器（服务端联机）：IP 与端口放在同一行。 -->
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionTitle" Text="中继服务器" />
								<StackPanel Name="RelayServerRow" Spacing="10"
											GotFocus="OnRelayServerFocusChanged"
											LostFocus="OnRelayServerFocusChanged">
									<Grid ColumnDefinitions="*,120,Auto,Auto" ColumnSpacing="8">
										<TextBox Grid.Column="0" Text="{Binding RelayServerIp}"
												 Watermark="中继服务器 IP / 主机名" />
										<TextBox Grid.Column="1" Text="{Binding RelayServerPort}"
												 Watermark="端口" />
										<Button Grid.Column="2" Classes="Flat" Content="确认"
												Command="{Binding SaveRelayServerCommand}"
												animations:VisibilityBehavior.IsVisible="{Binding IsEditingRelayServer}"
												animations:VisibilityBehavior.HiddenScale="0.8" />
										<Button Grid.Column="3" Classes="Basic" Content="取消"
												Command="{Binding CancelRelayServerCommand}"
												animations:VisibilityBehavior.IsVisible="{Binding IsEditingRelayServer}"
												animations:VisibilityBehavior.HiddenScale="0.8" />
									</Grid>

									<TextBlock Text="{Binding RelayServerError}" FontSize="{DynamicResource AppFontSizeSmall}"
											   Foreground="{DynamicResource ErrorBrush}"
											   IsVisible="{Binding HasRelayServerError}" />
								</StackPanel>

								<TextBlock Classes="cardHint"
										   Text="服务端联机使用的房间大厅服务器：连接后在这里列出、搜索、创建和加入房间。" />
							</StackPanel>
						</StackPanel>
					</Expander>
				</suki:GlassCard>

			</StackPanel>
		</ScrollViewer>
	</Border>
</UserControl>
