<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="kiriyamalauncher.Presentation.Views.HomeView"
			 xmlns:vm="clr-namespace:kiriyamalauncher.Presentation.ViewModels"
			 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             x:DataType="vm:HomeViewModel">

	<UserControl.Styles>
		<!-- 小节标题。 -->
		<Style Selector="TextBlock.sectionTitle">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="FontWeight" Value="DemiBold" />
			<Setter Property="Margin" Value="0,6,0,4" />
		</Style>

		<!-- 正文：次要色、可换行。 -->
		<Style Selector="TextBlock.body">
			<Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="LineHeight" Value="22" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Border Padding="32,28">
			<suki:GlassCard MaxWidth="680"
							HorizontalAlignment="Center"
							Padding="36,32"
							CornerRadius="18">

				<StackPanel Spacing="6">

					<!-- 头部：狗头 + 应用名 + 简介。 -->
					<Image Width="96" Height="96"
						   HorizontalAlignment="Center"
						   Source="avares://kiriyamalauncher.Presentation/Base/Assets/suki-dog.png" />
					<TextBlock HorizontalAlignment="Center"
							   FontSize="24" FontWeight="DemiBold"
							   Text="{Binding AppDisplayName}" />
					<TextBlock HorizontalAlignment="Center"
							   Classes="body" TextWrapping="Wrap"
							   Text="{Binding AppDescription}" />
					<TextBlock HorizontalAlignment="Center"
							   Classes="body" Opacity="0.75"
							   Text="{Binding ApplicationInfo}" />

					<Separator Margin="0,16" />

					<!-- 功能。 -->
					<TextBlock Classes="sectionTitle" Text="功能" />
					<TextBlock Classes="body" Text="{Binding Highlights}" />

					<!-- 鸣谢。 -->
					<TextBlock Classes="sectionTitle" Text="鸣谢" Margin="0,18,0,4" />
					<TextBlock Classes="body" Text="{Binding Thanks}" />
					<HyperlinkButton Classes="inlineHyperlink" Padding="0" HorizontalAlignment="Left"
									 Content="开源许可"
									 NavigateUri="{Binding LicenseURL}" />
				</StackPanel>
			</suki:GlassCard>
		</Border>
	</ScrollViewer>
</UserControl>
