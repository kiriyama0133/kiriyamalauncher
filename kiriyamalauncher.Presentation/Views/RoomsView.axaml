<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="kiriyamalauncher.Presentation.Views.RoomsView"
             x:DataType="vm:RoomsViewModel"
			 xmlns:vm="clr-namespace:kiriyamalauncher.Presentation.ViewModels"
			 xmlns:views="clr-namespace:kiriyamalauncher.Presentation.Views"
			 xmlns:i="using:Material.Icons.Avalonia"
			 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
			 xmlns:theme="clr-namespace:SukiUI.Theme;assembly=SukiUI">

	<UserControl.Styles>
		<!-- 房间卡片：与其他玻璃卡片统一（CornerRadius 14 / Padding 18 / 拉伸）。 -->
		<Style Selector="suki|GlassCard.roomCard">
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Padding" Value="18" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>

		<!-- 房间标题：名称，半粗体。 -->
		<Style Selector="TextBlock.roomTitle">
			<Setter Property="FontWeight" Value="DemiBold" />
			<Setter Property="FontSize" Value="{DynamicResource AppFontSizeSubtitle}" />
		</Style>

		<!-- 卡片元信息：房主 / 密码 / 人数等次要文本。 -->
		<Style Selector="TextBlock.roomMeta">
			<Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
			<Setter Property="FontSize" Value="{DynamicResource AppFontSizeSmall}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<StackPanel Spacing="14">

		<!-- 房间内页面：加入/创建房间后显示（ContentControl 由 ViewLocator 按命名约定解析 RoomView）。 -->
		<ContentControl Content="{Binding CurrentRoom}" IsVisible="{Binding IsInRoom}" />

		<!-- 房间大厅：未进房间时显示。 -->
		<StackPanel Spacing="14" IsVisible="{Binding !IsInRoom}">

		<!-- 头部：标题 + 在线房间数 + 操作按钮。 -->
		<Grid ColumnDefinitions="*,Auto">
			<StackPanel Grid.Column="0" Spacing="4">
				<TextBlock Text="房间大厅" FontSize="{DynamicResource AppFontSizeSubtitle}" FontWeight="DemiBold" />
				<StackPanel Orientation="Horizontal" Spacing="10">
					<StackPanel Orientation="Horizontal" Spacing="5">
						<i:MaterialIcon Kind="DoorOpen" Width="15" Height="15" VerticalAlignment="Center"
										Foreground="{DynamicResource SukiPrimaryColor}" />
						<TextBlock Text="{Binding OnlineRoomCount, StringFormat='在线房间：{0}'}" VerticalAlignment="Center"
								   FontWeight="DemiBold" Foreground="{DynamicResource SukiPrimaryColor}" />
					</StackPanel>
					<TextBlock Text="{Binding StatusText}" Classes="roomMeta" VerticalAlignment="Center" TextWrapping="Wrap" />
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
				<Button Classes="Flat" Command="{Binding CreateRoomCommand}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<i:MaterialIcon Kind="Plus" Width="15" Height="15" />
						<TextBlock Text="创建房间" />
					</StackPanel>
				</Button>
				<Button Classes="Basic" Command="{Binding RefreshCommand}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<i:MaterialIcon Kind="Refresh" Width="15" Height="15" />
						<TextBlock Text="刷新" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<!-- 搜索框。 -->
		<TextBox Text="{Binding SearchText}" Watermark="搜索房间……">
			<theme:TextBoxExtensions.Prefix>
				<i:MaterialIcon Kind="Search" Width="16" Height="16" />
			</theme:TextBoxExtensions.Prefix>
		</TextBox>

		<!-- 空态：还没有房间。 -->
		<TextBlock Text="还没有房间，点右上角「创建房间」开一个吧。"
				   HorizontalAlignment="Center" Opacity="0.6" Margin="0,20"
				   IsVisible="{Binding !HasRooms}" />

		<!-- 房间列表：每张卡片都是标准的玻璃卡片。 -->
		<ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding Rooms}">
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type vm:RoomRowViewModel}">
						<suki:GlassCard Classes="roomCard">
							<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

								<!-- 标题行：房间名 + 人数。 -->
								<Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="*,Auto">
									<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
										<TextBlock Classes="roomTitle" Text="{Binding Name}" />
										<i:MaterialIcon Kind="Lock" Width="13" Height="13" VerticalAlignment="Center"
														Foreground="{DynamicResource SukiLowText}"
														IsVisible="{Binding HasPassword}" />
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
										<i:MaterialIcon Kind="AccountMultiple" Width="14" Height="14" VerticalAlignment="Center"
														Foreground="{DynamicResource SukiPrimaryColor}" />
										<TextBlock Classes="roomMeta" Text="{Binding PlayerCountText}" VerticalAlignment="Center" />
									</StackPanel>
								</Grid>

								<!-- 信息行：房主 + 是否有密码 + 加入按钮。 -->
								<Grid Grid.Column="0" Grid.Row="1" ColumnDefinitions="Auto,Auto,*"
									  Margin="0,10,0,0">
									<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
										<i:MaterialIcon Kind="Account" Width="13" Height="13" VerticalAlignment="Center"
														Foreground="{DynamicResource SukiLowText}" />
										<TextBlock Classes="roomMeta" Text="{Binding HostName, StringFormat='房主：{0}'}" />
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="18,0,0,0">
										<i:MaterialIcon Kind="Lock" Width="13" Height="13" VerticalAlignment="Center"
														Foreground="{DynamicResource SukiLowText}" />
										<TextBlock Classes="roomMeta" Text="{Binding PasswordText}" />
									</StackPanel>
								</Grid>

								<!-- 加入按钮：右侧垂直居中，跨两行。 -->
								<Button Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Classes="Flat"
										Content="加入"
										Cursor="Hand"
										Command="{Binding JoinCommand}"
										IsEnabled="{Binding !IsFull}"
										ToolTip.Tip="{Binding IsFull, StringFormat='房间已满（{0}）'}"
										VerticalAlignment="Center" Margin="16,0,0,0" />
							</Grid>
						</suki:GlassCard>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		</StackPanel>

	</StackPanel>
</UserControl>
