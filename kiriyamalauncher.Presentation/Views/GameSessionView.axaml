<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="kiriyamalauncher.Presentation.Views.GameSessionView"
             x:DataType="vm:GameSessionViewModel"
			 xmlns:c="clr-namespace:kiriyamalauncher.Presentation.Base.Controls"
			 xmlns:vm="clr-namespace:kiriyamalauncher.Presentation.ViewModels"
			 xmlns:i="using:Material.Icons.Avalonia">

	<UserControl.Styles>
		<!-- 游戏卡片按钮：手型指针，悬停不放大，改为高亮卡片边线。 -->
		<Style Selector="Button.card">
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Button.card:pointerover">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="RenderTransform" Value="none" />
		</Style>

		<Style Selector="Button.card:pressed, Button.card:pressed:pointerover">
			<Setter Property="RenderTransform" Value="none" />
		</Style>

		<Style Selector="Button.card c|GameCard Border#PART_Card">
			<Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
		</Style>

		<Style Selector="Button.card:pointerover c|GameCard Border#PART_Card">
			<Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
		</Style>

		<!-- 联机面板里的说明卡片。 -->
		<Style Selector="Border.boardCard">
			<Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Padding" Value="18" />
			<Setter Property="MaxWidth" Value="560" />
			<Setter Property="HorizontalAlignment" Value="Left" />
		</Style>
	</UserControl.Styles>

	<Border Padding="24">
		<DockPanel>

			<!-- 一、游戏类别列表 -->
			<StackPanel DockPanel.Dock="Top" Spacing="6" IsVisible="{Binding !IsInGameBoard}">
				<TextBlock Text="游戏联机" FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="DemiBold" />
				<TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap" MaxWidth="620"
						   HorizontalAlignment="Left" />
			</StackPanel>

			<!-- 二、某个游戏的联机面板（这里才有「连接到虚拟局域网」） -->
			<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" IsVisible="{Binding IsInGameBoard}">

				<StackPanel Grid.Column="0" Spacing="6">
					<TextBlock Text="{Binding SelectedGame.Name}" FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="DemiBold" />
					<TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap" MaxWidth="560"
							   HorizontalAlignment="Left" />
				</StackPanel>

				<!-- 没接入时是「连接到虚拟局域网」，接入之后变成「断开局域网」。 -->
				<Button Grid.Column="1" Classes="Flat" VerticalAlignment="Top"
						Cursor="Hand"
						IsVisible="{Binding !IsConnected}"
						Command="{Binding ConnectToVirtualNetworkCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<i:MaterialIcon Kind="LanConnect" Width="16" Height="16" Foreground="White" />
						<TextBlock Text="连接到虚拟局域网" />
					</StackPanel>
				</Button>

				<Button Grid.Column="1" Classes="Basic" VerticalAlignment="Top"
						Cursor="Hand"
						IsVisible="{Binding IsConnected}"
						Command="{Binding DisconnectFromVirtualNetworkCommand}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<i:MaterialIcon Kind="LanDisconnect" Width="16" Height="16" />
						<TextBlock Text="断开局域网" />
					</StackPanel>
				</Button>
			</Grid>

			<ScrollViewer Margin="0,20,0,0">
				<Panel>
					<!-- 游戏卡片列表 -->
					<ItemsControl ItemsSource="{Binding Games}" IsVisible="{Binding !IsInGameBoard}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type vm:GameViewModel}">
								<Button Classes="Basic NoPressedAnimation card"
										Padding="0"
										Margin="0,0,16,16"
										CornerRadius="14"
										HorizontalAlignment="Left"
										Foreground="{DynamicResource SukiText}"
										Command="{Binding OpenCommand}"
										ToolTip.Tip="{Binding Description}">
									<c:GameCard />
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- 联机面板：虚拟局域网说明 + 游戏联机组件 -->
					<StackPanel Spacing="12" HorizontalAlignment="Left" IsVisible="{Binding IsInGameBoard}">
						<Border Classes="boardCard">
							<StackPanel Spacing="10">
								<TextBlock Text="虚拟局域网" FontSize="{DynamicResource AppFontSizeLarge}" FontWeight="DemiBold" />

								<TextBlock TextWrapping="Wrap" Opacity="0.7"
										   Text="连接后会为本机分配一个虚拟 IP。把这个 IP 告诉朋友，大家就能在游戏里用局域网模式互相看到。" />

								<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsConnected}">
									<i:MaterialIcon Kind="LanConnect" Width="14" Height="14" VerticalAlignment="Center"
													Foreground="{DynamicResource SukiPrimaryColor}" />
									<TextBlock Text="{Binding VirtualIp, StringFormat='当前虚拟 IP：{0}'}"
											   FontSize="{DynamicResource AppFontSizeCompact}"
											   VerticalAlignment="Center"
											   Foreground="{DynamicResource SukiPrimaryColor}" />
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- 游戏联机组件：选择启动路径 / 启动游戏 / 检测进程并注入 -->
						<ContentControl IsVisible="{Binding HasIntegration}">
							<c:GameIntegrationControl DataContext="{Binding Integration}" />
						</ContentControl>

						<!-- 局域网设备：轮询虚拟局域网并列出发现的设备 -->
						<c:LanDevicesControl DataContext="{Binding LanDevices}" />

					</StackPanel>
				</Panel>
			</ScrollViewer>

		</DockPanel>
	</Border>
</UserControl>
