<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="230"
             x:Class="kiriyamalauncher.Presentation.Base.Controls.GameIntegrationControl"
             x:DataType="vm:GameIntegrationViewModel"
			 xmlns:vm="clr-namespace:kiriyamalauncher.Presentation.ViewModels"
			 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI">

	<UserControl.Styles>
		<Style Selector="suki|GlassCard.integrationCard">
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Padding" Value="18" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
	</UserControl.Styles>

	<!--
		游戏联机面板：选启动路径 → 启动游戏 → 自动检测进程并注入组件。
		DataContext 是 GameIntegrationViewModel。
	-->
	<suki:GlassCard Classes="integrationCard">
		<suki:GroupBox Header="{Binding DisplayName, StringFormat='联机组件 · {0}'}">
			<StackPanel Spacing="12">

				<TextBlock Text="选好游戏的启动程序再点「启动游戏」；检测到游戏进程后会自动注入联机组件。"
						   FontSize="{DynamicResource AppFontSizeSmall}"
						   TextWrapping="Wrap"
						   Foreground="{DynamicResource SukiLowText}" />

				<!-- 启动路径 -->
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Grid.Column="0"
							 Text="{Binding ExecutablePath}"
							 PlaceholderText="{Binding ExecutableFileNameHint}" />
					<Button Grid.Column="1"
							Classes="Basic"
							Content="浏览…"
							Cursor="Hand"
							Command="{Binding BrowseCommand}" />
				</Grid>

				<!-- 操作 -->
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Classes="Flat"
							Content="启动游戏"
							Cursor="Hand"
							IsEnabled="{Binding CanLaunch}"
							Command="{Binding LaunchCommand}" />
					<Button Classes="Basic"
							Content="立即注入"
							Cursor="Hand"
							IsEnabled="{Binding !IsBusy}"
							Command="{Binding InjectNowCommand}" />
					<Button Classes="Basic"
							Content="卸载注入"
							Cursor="Hand"
							IsEnabled="{Binding !IsBusy}"
							Command="{Binding RemoveInjectionCommand}" />
					<ToggleSwitch Content="自动注入"
								  VerticalAlignment="Center"
								  IsChecked="{Binding IsAutoInjectEnabled}" />
				</StackPanel>

				<!-- 状态 -->
				<StackPanel Orientation="Horizontal" Spacing="8">
					<ProgressBar Width="90"
								 Height="4"
								 IsIndeterminate="True"
								 VerticalAlignment="Center"
								 IsVisible="{Binding IsBusy}" />
					<TextBlock Text="{Binding StatusText}"
							   FontSize="{DynamicResource AppFontSizeSmall}"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource SukiLowText}" />
				</StackPanel>

				<!-- 权限提示：非管理员时提醒（游戏若以管理员启动，注入会失败） -->
				<TextBlock Text="{Binding ElevationHint}"
						   FontSize="{DynamicResource AppFontSizeSmall}"
						   TextWrapping="Wrap"
						   IsVisible="{Binding !IsElevated}"
						   Foreground="{DynamicResource ErrorBrush}" />

			</StackPanel>
		</suki:GroupBox>
	</suki:GlassCard>
</UserControl>
